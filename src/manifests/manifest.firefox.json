{
  "manifest_version": 3,
  "name": "KOSTEAM",
  "version": "1.6.4",
  "description": "Steam 상점 페이지에서 한국어 패치 정보를 확인하세요",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.steampowered.com/*",
    "https://raw.githubusercontent.com/snowyegret23/KOSTEAM/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/cart*"
      ],
      "js": [
        "cart.js"
      ],
      "css": [
        "cart.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://checkout.steampowered.com/checkout*"
      ],
      "js": [
        "cart_restore.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "search_bypass.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://steamcommunity.com/app/*"
      ],
      "js": [
        "community.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alevo0918@gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "locationInfo",
          "websiteContent",
          "websiteActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
