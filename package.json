{
  "name": "kosteam",
  "version": "1.6.4",
  "description": "Steam Korean Localization Info Scraper & Chrome Extension",
  "type": "module",
  "scripts": {
    "scrape:steamapp": "node scrapers/hanpe.js",
    "scrape:directg": "node scrapers/directg.js",
    "scrape:stove": "node scrapers/stove.js",
    "scrape:curator": "python scrapers/steam_curator_dump.py --quasarplay",
    "scrape:all": "npm run scrape:steamapp && npm run scrape:directg && npm run scrape:stove && npm run scrape:curator",
    "scrape:merge": "npm run merge",
    "merge": "node scripts/merge.js",
    "resolve-links": "node scripts/resolve-links.js",
    "resolve-links:verify": "node scripts/resolve-links.js --verify",
    "build:data": "npm run scrape:all && npm run merge",
    "build:data:full": "npm run scrape:all && npm run resolve-links && npm run merge",
    "build:ext": "npm run clean && rollup -c",
    "build:ext:prod": "npm run clean && rollup -c --environment NODE_ENV:production",
    "build:ext:watch": "npm run clean && rollup -c -w",
    "build": "npm run build:ext:prod",
    "clean": "node -e \"const fs=require('fs');['dist'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "zip:chrome": "web-ext build --source-dir dist/chrome --artifacts-dir . --filename kosteam-chrome.zip --overwrite-dest",
    "zip:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir . --filename kosteam-firefox.zip --overwrite-dest",
    "zip": "npm run build && npm run zip:chrome && npm run zip:firefox",
    "test": "node --test",
    "lint:firefox": "npm run build && web-ext lint --source-dir dist/firefox",
    "test:firefox": "npm run lint:firefox && web-ext run --source-dir dist/firefox"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.40.0",
    "rollup-plugin-copy": "^3.5.0",
    "web-ext": "10.6.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
